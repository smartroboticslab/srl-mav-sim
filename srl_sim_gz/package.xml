<package format="3">
  <name>srl_sim_gz</name>
  <version>0.1.0</version>
  <description>Simulator for SRL MAVs using PX4 and Gazebo</description>
  <author email="s.papatheodorou18@imperial.ac.uk">Sotiris Papatheodorou</author>
  <maintainer email="s.papatheodorou18@imperial.ac.uk">Sotiris Papatheodorou</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>px4</exec_depend>
  <exec_depend>ros_gz</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>ros_gz_point_cloud</exec_depend>
  <exec_depend>srl_sim_util</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
