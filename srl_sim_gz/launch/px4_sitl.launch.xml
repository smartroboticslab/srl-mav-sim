<?xml version="1.0"?>
<launch>
  <!--
  The PX4 airframe to use. For available airframes see
  PX4-Autopilot/ROMFS/px4fmu_common/init.d-posix/airframes
  Make sure to remove the leading number and underscode, e.g. 10016_iris should
  be written as iris in the argument.
  -->
  <arg name="airframe" default="rmf_owl"/>

  <node pkg="srl_sim_gz"
        exec="px4_sitl.sh"
        name="px4_sitl"
        args="$(find-pkg-prefix srl_sim_gz) gz_$(var airframe)"
        output="screen"/>

  <!-- Launching this via the executable tag instead of include is the only way to controll the output in ros2 -->
  <executable cmd="ros2 launch mavros px4.launch fcu_url:=udp://:14540@127.0.0.1:14557" output="log"/>
</launch>
