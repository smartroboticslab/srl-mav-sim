<?xml version="1.0"?>
<launch>
  <!--
  The PX4 airframe to use. For available airframes see
  PX4-Autopilot/ROMFS/px4fmu_common/init.d-posix/airframes
  Make sure to remove the leading number and underscode, e.g. 10016_iris should
  be written as iris in the argument.
  -->
  <arg name="airframe" default="rmf_owl"/>

  <!-- The world to load in Gazebo. It must contain the MAV model. -->
  <arg name="world" default="$(find-pkg-share srl_sim_gz)/resources/worlds/depot.world"/>

  <!-- Whether to show the Gazebo GUI. -->
  <arg name="gui" default="true"/>

  <include file="$(find-pkg-share srl_sim_gz)/launch/px4_sitl.launch.xml">
    <arg name="airframe" value="$(var airframe)"/>
  </include>

  <include file="$(find-pkg-share srl_sim_gz)/launch/gazebo.launch.xml">
    <arg name="airframe" value="$(var airframe)"/>
    <arg name="world" value="$(var world)"/>
    <arg name="gui" value="$(var gui)"/>
  </include>
</launch>
